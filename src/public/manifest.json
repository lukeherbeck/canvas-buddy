{
  "manifest_version": 3,
  "name": "CanvasBuddy",
  "version": "0.1.0",
  "description": "Level up your Canvas experience with a companion that grows as you complete assignments.",
  "permissions": ["storage"],
  "host_permissions": ["https://*.instructure.com/*", "https://canvas.tamu.edu/*"],
  "content_scripts": [
    {
      "matches": ["https://*.instructure.com/*", "https://canvas.tamu.edu/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CanvasBuddy Settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["sprites/*.png"],
      "matches": ["https://*.instructure.com/*", "https://canvas.tamu.edu/*"]
    }
  ]
}
